# Envío del formulario de contacto con Resend (https://resend.com).
# Si falta alguna, el formulario NO envía nada: muestra que el envío no está conectado
# y ofrece escribir por correo.
RESEND_API_KEY=
# Dirección que recibe las solicitudes (la tuya).
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Portfolio <hola@tudominio.es>".
CONTACT_FROM_EMAIL=
